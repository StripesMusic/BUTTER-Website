{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "butter-website",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // The app uses /music and /tour paths, so unknown paths serve index.html
    "not_found_handling": "single-page-application"
  }
}
